name: Portfolio QA and Pages
on:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: portfolio-pages
  cancel-in-progress: false
jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: npm install --no-audit --no-fund
      - run: npx playwright install --with-deps chromium
      - name: Execute tests
        id: tests
        continue-on-error: true
        run: npm test
      - name: Assemble public site and results
        run: |
          mkdir -p public
          cp index.html style.css script.js favicon.svg .nojekyll qa-suite.html qa-suite.css qa-suite.js case-schema.js cases.json public/
          cp -r qa-results public/
      - uses: actions/upload-pages-artifact@v3
        with:
          path: public
      - name: Preserve failing test status
        if: steps.tests.outcome == 'failure'
        run: exit 1
  deploy:
    needs: test
    if: ${{ !cancelled() && (needs.test.result == 'success' || needs.test.result == 'failure') }}
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Deploy portfolio and actual results
        id: deployment
        uses: actions/deploy-pages@v4
